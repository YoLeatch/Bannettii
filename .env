# Configurações de Ambiente - Desenvolvimento Local

# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bennettii
DB_USER=root
# Deixe a senha vazia para XAMPP padrão, ou preencha se tiver definido uma
DB_PASSWORD=

# JWT Secret (Chave gerada para desenvolvimento)
JWT_SECRET=bennettii_dev_secret_key_2025_secure_hash

# Application Environment
APP_ENV=local
APP_DEBUG=true
# Ajuste se sua URL local for diferente (ex: http://localhost:8080)
APP_URL=http://localhost

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true

# Upload Settings
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# reCAPTCHA Configuration (Adicione suas chaves se for testar recaptcha)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Email Configuration (Para testes locais você pode usar Mailtrap ou deixar vazio)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
