# Configurações de Ambiente - Desenvolvimento Local

# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bennettii
DB_USER=root
# Deixe a senha vazia para XAMPP padrão, ou preencha se tiver definido uma
DB_PASSWORD=

# JWT Secret (Chave gerada para desenvolvimento)
JWT_SECRET=bennettii_dev_secret_key_2025_secure_hash

# Encryption Key (Chave para criptografia de dados sensíveis como cartões)
# IMPORTANTE: Em produção, use uma chave forte e única!
ENCRYPTION_KEY=bennettii_sensitive_data_encryption_key_2025

# Application Environment
APP_ENV=local
APP_DEBUG=true
# Ajuste se sua URL local for diferente (ex: http://localhost:8080)
APP_URL=http://localhost

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true

# Upload Settings
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=6LeTbCYsAAAAAP3qJyJsw_v7taJw4ms22xL47Z3R
RECAPTCHA_SECRET_KEY=6LeTbCYsAAAAAB6VedPsf1oepc9FRUPKJ72IywQv

# Email Configuration (Para testes locais você pode usar Mailtrap ou deixar vazio)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
