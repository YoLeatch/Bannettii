# Configurações de Ambiente - Hostinger

# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=seu_database_name
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# JWT Secret (gere uma chave aleatória segura)
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres

# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seusite.com

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTPONLY=true

# Upload Settings
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=sua_chave_do_site_aqui
RECAPTCHA_SECRET_KEY=sua_chave_secreta_aqui

# Email Configuration (se usar)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@seudominio.com
MAIL_PASSWORD=sua_senha_email
MAIL_ENCRYPTION=tls
