<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Proteger o arquivo .env (CRÍTICO!)
    <Files .env>
        Order allow,deny
        Deny from all
    </Files>

    # 2. Redirecionar todo o tráfego para a pasta public
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>